# Aucun appel payant n'est activé par défaut. Secrets : jamais NEXT_PUBLIC_*.
# Les commandes CLI lisent ces variables dans le shell, sans chargement implicite.
PROBE_TOKEN=
WEB_PROBE_URL=http://localhost:8787
BROWSER_PROBE_URL=http://localhost:8788
RENDER_PROBE_URL=http://localhost:8789
# Pour la future vérification distante seulement :
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Aucun appel OpenAI ni achat de crédits au sprint 00.
# Sprint 01 : variable serveur dans apps/web/wrangler.jsonc, false par défaut.
# Activer ce drapeau ne suffit pas : generation_control doit autoriser le travail,
# et l'authentification produit reste non implémentée. Aucun secret NEXT_PUBLIC_*.
GENERATIONS_ENABLED=false
BIENVU_FOUNDATIONS_URL=http://localhost:8787
