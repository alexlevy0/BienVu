{
  "name": "@bienvu/web",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "node ../../scripts/prepare-maplibre-assets.mjs && node ../../scripts/prepare-home-marketing-styles.mjs && next dev",
    "build": "node ../../scripts/prepare-maplibre-assets.mjs && node ../../scripts/prepare-home-marketing-styles.mjs && next build --webpack",
    "build:worker": "node ../../scripts/prepare-maplibre-assets.mjs && node ../../scripts/prepare-home-marketing-styles.mjs && opennextjs-cloudflare build",
    "preview": "wrangler dev --port 8787 --local",
    "typegen": "wrangler types --strict-vars false --env-interface CloudflareEnv cloudflare-env.d.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@bienvu/avatars": "workspace:*",
    "@bienvu/contracts": "workspace:*",
    "@bienvu/db": "workspace:*",
    "@bienvu/importers": "workspace:*",
    "@bienvu/maps": "workspace:*",
    "@bienvu/narration": "workspace:*",
    "@bienvu/notifications": "workspace:*",
    "@bienvu/observability": "workspace:*",
    "@bienvu/voice": "workspace:*",
    "@opennextjs/cloudflare": "1.20.6",
    "better-auth": "1.7.10",
    "canvas-confetti": "1.9.4",
    "fast-png": "8.0.0",
    "hls.js": "1.7.3",
    "jpeg-js": "0.4.4",
    "maplibre-gl": "6.14.0",
    "motion": "14.3.0",
    "next": "16.4.2",
    "postal-mime": "4.0.7",
    "posthog-js": "1.438.12",
    "posthog-node": "5.56.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sanitize-html": "2.18.1",
    "stripe": "23.0.0",
    "web-vitals": "6.2.3",
    "zod": "4.6.7",
    "@bienvu/presentation": "workspace:*"
  },
  "devDependencies": {
    "@posthog/nextjs-config": "1.11.3",
    "@types/canvas-confetti": "1.9.0",
    "@types/sanitize-html": "2.16.2"
  }
}
