PROBE_TOKEN=
# Accès administratif : une seule adresse exacte, vérifiée par Better Auth.
# Vide = aucun administrateur. Ne pas utiliser NEXT_PUBLIC_*.
SUPER_ADMIN_EMAIL=
# Compteurs de pages/pays agrégés, sans IP ni identifiant. Désactivé en local.
TRAFFIC_ENABLED=false
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_SECRET=
# Facultatif pour une connexion Google réelle. Ne pas remplacer le secret aléatoire.
GOOGLE_CLIENT_ID=
# Doit correspondre exactement à l'origine et au callback déclarés chez Google.
BETTER_AUTH_URL=http://localhost:8787
# true : e-mail vérifié et session automatique, uniquement en local loopback.
AUTH_EMAIL_VERIFICATION_BYPASS=false
LOCAL_IMPORT_TOKEN=
# Outil Node local : pnpm dev:imports. Cloudflare utilise le service privé.
IMPORT_MODE=local
# E-mails : valeurs locales dans wrangler.jsonc (AUTH_EMAIL_MODE=local, simulateur).
# Ne pas y copier un expéditeur réel ; voir docs/AUTHENTIFICATION.md pour le staging.

# Secret partagé web/service privé (généré séparément pour le staging).
IMPORT_TOKEN=

# Essai anonyme : désactivé par défaut. Aucun secret dans NEXT_PUBLIC_*.
ANONYMOUS_TRIALS_ENABLED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TRIAL_IP_HMAC_SECRET=
# Au moins 32 caractères aléatoires, distincts du secret Better Auth.
