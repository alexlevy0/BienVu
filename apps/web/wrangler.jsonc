{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "bienvu-web-probe-local",
  "main": "worker.ts",
  "compatibility_date": "2026-09-27",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "vars": {
    "SOCIAL_ENABLED": "false",
    "META_APP_ID": "",
    "META_GRAPH_VERSION": "v25.0",
    "META_LOGIN_CONFIG_ID": "",
    "TRAFFIC_ENABLED": "false",
    "BILLING_MODE": "disabled",
    "STRIPE_AUTOMATIC_TAX": "false",
    "SUPER_ADMIN_EMAIL": "",
    "PROBE_MODE": "local",
    "GENERATIONS_ENABLED": "false",
    "BETTER_AUTH_URL": "http://localhost:8787",
    "GOOGLE_CLIENT_ID": "",
    "AUTH_EMAIL_MODE": "local",
    "AUTH_EMAIL_FROM": "connexion@bienvu.example",
    "AUTH_EMAIL_VERIFICATION_BYPASS": "false",
    "IMPORT_MODE": "disabled",
    "ANONYMOUS_TRIALS_ENABLED": "false",
    "TURNSTILE_SITE_KEY": ""
  },
  "send_email": [
    {
      "name": "AUTH_EMAIL",
      "remote": false
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bienvu-probes-local",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "../../packages/db/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "bienvu-probes-local"
    }
  ],
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "logs": {
      "enabled": true,
      "invocation_logs": false,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  },
  "triggers": {"crons": ["23 3 * * *", "* * * * *"]},
  "services": [
    {
      "binding": "IMPORT_SERVICE",
      "service": "bienvu-import-local"
    },
    {
      "binding": "GENERATION_SERVICE",
      "service": "bienvu-generation-local"
    }
  ]
}
