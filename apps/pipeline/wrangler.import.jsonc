{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "bienvu-import-local",
  "main": "src/import-worker.ts",
  "compatibility_date": "2026-09-28",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {"PROBE_MODE": "local", "IMPORTS_ENABLED": "false"},
  "containers": [{"class_name": "ImportTransportContainer", "image": "../importer/Dockerfile", "image_build_context": "../..", "max_instances": 1, "instance_type": "basic"}],
  "durable_objects": {"bindings": [{"name": "IMPORT_CONTAINER", "class_name": "ImportTransportContainer"}]},
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["ImportTransportContainer"]}],
  "browser": {"binding": "BROWSER"},
  "d1_databases": [{"binding": "DB", "database_name": "bienvu-probes-local", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "../../packages/db/migrations"}],
  "r2_buckets": [{"binding": "MEDIA", "bucket_name": "bienvu-probes-local"}],
  "observability": {"enabled": true, "redact_query_string": true, "logs": {"enabled": true, "invocation_logs": false}, "traces": {"enabled": true, "head_sampling_rate": 0.1}},
  "limits": {"cpu_ms": 30000},
  "triggers": {"crons": ["*/10 * * * *"]}
}
