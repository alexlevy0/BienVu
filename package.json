{
  "name": "bienvu",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=24.17.0 <25"
  },
  "scripts": {
    "dev": "pnpm --filter @bienvu/web dev",
    "preview": "pnpm --filter @bienvu/web preview",
    "db:migrate": "pnpm --filter @bienvu/web exec wrangler d1 migrations apply DB --local",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check": "pnpm check:boundaries && pnpm test && pnpm typecheck",
    "probe:foundations": "node scripts/probe-foundations.mjs",
    "setup:local": "node scripts/setup-local.mjs",
    "fixtures": "tsx scripts/generate-fixtures.ts",
    "test": "tsx --test --test-concurrency=2 tests/*.test.ts",
    "typecheck": "pnpm -r typecheck && tsc -p tsconfig.tests.json",
    "generations:pause": "node scripts/pause-generations.mjs",
    "probe:generations": "tsx scripts/generation-operator.mjs",
    "build:web": "node scripts/build-web.mjs",
    "prepare:web": "node scripts/prepare-web-error-tracking.mjs",
    "probe:web": "node scripts/probe-web.mjs",
    "probe:seo": "node scripts/probe-seo.mjs",
    "assets:seo": "node scripts/prepare-seo-assets.mjs",
    "assets:blog": "tsx scripts/prepare-blog-assets.ts",
    "optimize:homepage": "node scripts/optimize-homepage.mjs",
    "probe:browser": "node scripts/probe-browser.mjs",
    "probe:renderer": "node scripts/probe-renderer.mjs",
    "render:local": "node scripts/renderer-native.mjs render",
    "serve:renderer": "node scripts/renderer-native.mjs serve",
    "budget": "tsx scripts/budget.ts",
    "versions": "node scripts/versions.mjs",
    "probe:accounts": "node scripts/probe-accounts.mjs",
    "probe:auth-email": "node scripts/probe-auth-email.mjs",
    "dev:imports": "tsx scripts/serve-imports.ts",
    "probe:imports": "tsx scripts/probe-imports.ts",
    "probe:portals": "tsx scripts/probe-portals.ts",
    "probe:voice": "tsx scripts/probe-voice.ts",
    "probe:voice:worker": "node scripts/probe-voice-worker.mjs",
    "probe:narration": "tsx scripts/probe-narration.ts",
    "probe:narration:worker": "tsx scripts/probe-narration-worker.ts",
    "probe:narration:cloudflare": "node --import tsx scripts/probe-narration-cloudflare.mjs",
    "imports:cleanup": "tsx scripts/cleanup-imports.ts",
    "fixtures:video": "tsx scripts/prepare-video-fixtures.ts",
    "render:video": "node scripts/renderer-native.mjs video",
    "probe:video:cloudflare": "node --import tsx scripts/probe-video-cloudflare.mjs",
    "probe:video:container": "node --import tsx scripts/probe-video-container.mjs",
    "preview:video": "node scripts/preview-video.mjs",
    "probe:trial:video": "tsx scripts/probe-anonymous-video.ts",
    "probe:trial:media": "tsx scripts/probe-trial-media.ts",
    "probe:trial:ui": "node scripts/probe-trial-ui.mjs",
    "probe:pricing:ui": "node --import tsx scripts/probe-pricing-ui.mjs",
    "probe:partners:ui": "node scripts/probe-partners-ui.mjs"
  },
  "devDependencies": {
    "@posthog/cli": "0.18.10",
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.2.3",
    "miniflare": "5.20260926.0-alpha",
    "playwright-core": "1.62.1",
    "sharp": "0.35.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "wrangler": "4.142.0"
  }
}
