# Application Meta pour les connexions facultatives Instagram et Facebook.
# Copier dans .env.social : ce fichier local est ignoré par Git.
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v25.0
# Facultatif : configuration Facebook Login for Business.
META_LOGIN_CONFIG_ID=
# 32 octets aléatoires, encodés en base64url sans padding (43 caractères).
# Conserver cette clé : la remplacer oblige à reconnecter tous les comptes.
SOCIAL_TOKEN_ENCRYPTION_KEY=
SOCIAL_ENABLED=false
